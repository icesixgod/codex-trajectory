{
  "description": "Restore the opted-in Codex Trajectory shortcut as a session starts.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${PLUGIN_ROOT}/scripts/codex_trajectory_bootstrap.py\"",
            "commandWindows": "uvw run --script \"%PLUGIN_ROOT%\\scripts\\codex_trajectory_bootstrap.py\"",
            "timeout": 86400,
            "async": true
          }
        ]
      }
    ]
  }
}
